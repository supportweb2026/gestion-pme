{
  "name": "gestion-pme",
  "version": "0.1.0",
  "private": true,
  "description": "Logiciel de gestion PME hors ligne d'abord : facturation, dépenses, comptabilité SYSCOHADA, projets.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "local": "npm run build && node --experimental-strip-types --no-warnings dev/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply gestion-pme --remote",
    "deploy": "npm run build && wrangler d1 migrations apply gestion-pme --remote && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
