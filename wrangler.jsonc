// Déploiement Cloudflare, entièrement dans l'offre gratuite :
//  - le Worker répond aux routes /api/* ;
//  - tout le reste (l'application) est servi en fichiers statiques depuis dist/,
//    sans limite de requêtes et sans facturation ;
//  - D1 est la base centrale de synchronisation.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestion-pme",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestion-pme",
      "database_id": "a8ccf93a-4610-4b36-aab6-6cbddc4dfdbd",
      "migrations_dir": "migrations"
    },
    {
      // Justificatifs (photos de reçus) : base séparée, gratuite, sans carte bancaire.
      "binding": "FILES",
      "database_name": "gestion-pme-fichiers",
      "database_id": "447cdfe8-ff18-432a-b2c2-bc0e91d7fccd"
    }
  ],
  // Entreprise éditrice (IDO) : ses administrateurs gèrent la plateforme Gestia.
  "vars": { "PLATFORM_COMPANY": "a6de1303-7072-48ba-8dac-c259e192f4dd" },
  "observability": { "enabled": true }
}
